@page
@model DBSys.Pages.Payments.IndexModel

<h2>Fake Payment Processor</h2>

<form method="post">
    <label>Amount:</label>
    <input type="number" step="0.01" asp-for="Amount" required />

    <br /><br />

    <label>Processor:</label>
    <select asp-for="ProcessorName">
        <option value="FakeStripe">FakeStripe</option>
        <option value="FakePayPal">FakePayPal</option>
    </select>

    <br /><br />

    <button type="submit">Process Payment</button>
</form>

<hr />

<h3>Payment History</h3>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Processor</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Auth Code</th>
            <th>Requested</th>
            <th>Responded</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Payments)
        {
            <tr>
                <td>@p.PaymentId</td>
                <td>@p.ProcessorName</td>
                <td>@p.Amount</td>
                <td>@p.PaymentStatus</td>
                <td>@p.AuthorizationCode</td>
                <td>@p.RequestedAt</td>
                <td>@p.RespondedAt</td>
            </tr>
        }
    </tbody>
</table>