@page
@model IndexModel
@{
    ViewData["Title"] = "SF Sales";
}

<div class="container mt-5">

    <div class="mb-5">
        <h1 class="mb-3">State Fair Sales Dashboard</h1>
        <p>
            Welcome to the State Fair Sales Dashboard — your central hub for tracking, analyzing,
            and optimizing vendor performance across the fairgrounds. Whether you're managing daily
            transactions, monitoring product trends, or reviewing vendor activity, this platform is
            designed to give you clear, actionable insights in real time.
        </p>
    </div>

    <div class="mb-5">
        <p>
            From deep-fried favorites to classic fair treats, every sale tells a story. Our system
            captures detailed data across vendors, locations, and product categories, helping you
            understand what’s selling, when it’s selling, and where demand is highest. Use this
            information to streamline operations, reduce waste, and maximize revenue throughout the event.
        </p>
    </div>

    <div class="mb-5">
        <p>

        </p>
    </div>

    <div class="row mb-5">
        <div class="col-md-6 mb-4">
            <img src="https://d20kvx01grnrq8.cloudfront.net/wp-content/uploads/2024/09/Minnesota-State-Fair-crowd-Caitlin-Abrams-photo.jpg" class="img-fluid rounded shadow-sm" alt="State fair crowd">
        </div>
        <div class="col-md-6 mb-4">
            <img src="https://static.vecteezy.com/system/resources/thumbnails/078/722/331/small/a-close-up-view-of-a-corn-dog-with-mustard-and-ketchup-being-held-against-a-blurry-carnival-photo.jpg" class="img-fluid rounded shadow-sm" alt="Fair food close-up">
        </div>
    </div>

    <div class="mb-5">
        <p>
        </p>
    </div>

</div>

